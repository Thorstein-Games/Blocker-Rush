{
  "name": "blocker-rush",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/web",
    "verify": "bash ./verify.sh",
    "gen-puzzles": "node packages/shared/scripts/generate-puzzles.js",
    "refresh-samples": "node packages/shared/scripts/sample-puzzles.js",
    "sync:megingjord": "node scripts/sync-megingjord.mjs",
    "check:megingjord": "node scripts/sync-megingjord.mjs --check"
  }
}
